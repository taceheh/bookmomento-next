generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model book_reactions {
  id         BigInt        @id @default(autoincrement())
  user_id    String        @db.Uuid
  book_isbn  String
  reaction   reaction_type
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  updated_at DateTime      @default(now()) @db.Timestamptz(6)

  @@unique([user_id, book_isbn], map: "uq_user_book")
  @@index([book_isbn, reaction], map: "idx_book_reactions_book_reaction")
  @@index([user_id], map: "idx_book_reactions_user")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model books {
  isbn13               String    @id
  isbn10               String?
  title                String
  author               String?
  publisher            String?
  cover                String?
  description          String?
  pub_date             DateTime? @db.Date
  category_id          Int?
  category_name        String?
  price_standard       Int?
  price_sales          Int?
  sales_point          Int?
  customer_review_rank Int?
  link                 String?
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model comments {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?    @db.Uuid
  book_isbn      String
  parent_id      String?    @db.Uuid
  root_id        String     @db.Uuid
  depth          Int        @default(0)
  body           String
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime   @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?  @db.Timestamptz(6)
  comments       comments?  @relation("commentsTocomments", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_comments comments[] @relation("commentsTocomments")
  users          users?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([book_isbn, parent_id, created_at], map: "comments_book_root_idx")
  @@index([parent_id, created_at], map: "comments_parent_idx")
  @@index([book_isbn, root_id, created_at], map: "comments_root_idx")
  @@index([user_id, created_at], map: "comments_user_idx")
}

model users {
  id         String     @id @db.Uuid
  email      String?
  provider   String?
  nickname   String?
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  comments   comments[]
}

enum reaction_type {
  like
  dislike
}
